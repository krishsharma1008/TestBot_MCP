# ============================================================
# Healix — Root .env.example
# Single source of truth for every env var used across webapp + MCP.
# Copy to .env.local (root) and into webapp/.env.local, then fill values.
# See AWS_MANUAL_SETUP.md for AWS setup instructions.
# ============================================================

# ── AWS Cognito (Auth) ───────────────────────────────────────
# AWS Console → Cognito → User Pools
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AWS S3 (Artifact Storage) ────────────────────────────────
# Same IAM credentials cover both Cognito and S3
AWS_S3_BUCKET_NAME=healix-test-artifacts
AWS_ACCESS_KEY_ID=AKIAxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Database (Drizzle) ───────────────────────────────────────
# Local dev:   direct connection (port 5432)
# Production:  Transaction pooler URI (port 6543)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── OpenAI (webapp, server-side only) ────────────────────────
# Used by /api/generate-tests, /api/parse-prd, /api/analyze-failures.
# Never touches user machines — MCP clients authenticate via HEALIX_API_KEY.
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.5-mini

# ── Webapp dashboard URL (optional) ──────────────────────────
# Where the MCP deep-links into when a test run finishes.
HEALIX_DASHBOARD_URL=https://app.healix.sh

# ── MCP (users' machines) ────────────────────────────────────────────
# Users only ever need this one — everything else lives on the webapp.
HEALIX_API_KEY=hlx_...

# ── Feature flags (optional) ─────────────────────────────────
# Opt-in LLM-driven agent planner. Default (off) uses rule-based routing.
HEALIX_PLANNER_AGENT=0
# AI-guard requests-per-minute ceiling per user.
AI_MAX_REQUESTS_PER_MINUTE=20

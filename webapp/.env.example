# ============================================================
# Webapp Environment Variables
# Copy to .env.local and fill in your values
# ============================================================

# ── AWS Cognito (Auth) ───────────────────────────────────────
# Found in: AWS Console → Cognito → User Pools
# See AWS_MANUAL_SETUP.md for full setup instructions
AWS_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── AWS S3 (Artifact Storage) ────────────────────────────────
# Found in: AWS Console → S3 + IAM
# Same AWS credentials cover both Cognito and S3
AWS_S3_BUCKET_NAME=healix-test-artifacts
AWS_ACCESS_KEY_ID=AKIAxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Database (Drizzle / direct connection) ───────────────────
# For LOCAL development: use the direct connection string (port 5432)
#   Found in: Supabase Dashboard → Settings → Database → Connection string → URI
# For PRODUCTION (Vercel): use the Transaction pooler URL (port 6543)
#   Found in: Supabase Dashboard → Settings → Database → Connection pooling → Transaction mode
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ── OpenAI (SERVER-SIDE ONLY) ────────────────────────────────
# This key is used by /api/generate-tests and /api/analyze-failures
# to handle AI requests on behalf of all MCP users.
# Users never need their own OpenAI key — they authenticate via HEALIX_API_KEY.
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.5-mini

# ── Inngest (Phase 2 async generation) ───────────────────────
INNGEST_EVENT_KEY=            # Production event key from Inngest dashboard
INNGEST_SIGNING_KEY=          # Webhook signature verification key
INNGEST_DEV=                  # Set to 1 only for local inngest-cli dev
HEALIX_GEN_ASYNC=false        # Flip to true to route /api/generate-tests through Inngest

# ── Stripe (Payments) ────────────────────────────────────────
# Found in: Stripe Dashboard → Developers → API keys
STRIPE_SECRET_KEY=sk_live_...
# Found in: Stripe Dashboard → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Found in: Stripe Dashboard → Products → [plan] → Price ID (e.g. price_xxx)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_TEAM=price_...

# ── App URL (used for Stripe redirect URLs) ──────────────────
NEXT_PUBLIC_APP_URL=https://your-domain.com

{
  "name": "@zapminds/mcp",
  "version": "2.0.3",
  "description": "Healix MCP Server — thin client, billing via Healix webapp (HEALIX_API_KEY only)",
  "main": "dist/index.js",
  "bin": {
    "healix-mcp": "bin/healix-mcp.js"
  },
  "scripts": {
    "build": "esbuild src/index.js src/pipeline-worker.js --bundle --platform=node --target=node18 --outdir=dist --minify --format=cjs --external:sharp --external:@playwright/test --external:@playwright/mcp --external:playwright-core --external:playwright --external:chromium-bidi --external:fsevents --external:bufferutil --external:utf-8-validate",
    "prepublishOnly": "npm run build",
    "start": "npm run build && node dist/index.js",
    "dev": "node src/index.js",
    "test": "node --test test/*.test.js test/**/*.test.js"
  },
  "keywords": [
    "testing",
    "playwright",
    "mcp",
    "ai",
    "automation",
    "e2e",
    "regression",
    "openai",
    "test-generation"
  ],
  "author": "Zapminds",
  "license": "MIT",
  "files": [
    "bin/",
    "dist/",
    "dashboard/",
    "scripts/",
    "mcp-launcher.js"
  ],
  "devDependencies": {
    "c8": "^11.0.0",
    "esbuild": "^0.25.12",
    "mocha": "^11.7.6"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@playwright/test": "^1.49.0",
    "dotenv": "^16.3.1",
    "form-data": "^4.0.0",
    "node-fetch": "^2.7.0",
    "open": "^8.4.2",
    "sharp": "^0.33.0",
    "yauzl": "^3.3.0",
    "zod": "^3.25.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
